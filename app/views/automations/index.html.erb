<div class="container">
  <div class="automations-layout">
    <aside class="automations-sidebar">
    <div class="automations-sidebar-section">
      <h3 class="automations-sidebar-title">
        <i class="fa-solid fa-graduation-cap"></i>
        Installer un skill
      </h3>
      <p class="automations-sidebar-hint">
        Suivez le tutoriel adapté à votre assistant.
      </p>
      <nav class="automations-sidebar-nav">
        <%= link_to tutorials_claude_path, class: "automations-sidebar-link" do %>
          <i class="fa-solid fa-comment-dots"></i>
          <span>Claude</span>
        <% end %>
        <%= link_to tutorials_chatgpt_path, class: "automations-sidebar-link" do %>
          <i class="fa-solid fa-robot"></i>
          <span>ChatGPT</span>
        <% end %>
        <%= link_to tutorials_gemini_path, class: "automations-sidebar-link" do %>
          <i class="fa-solid fa-gem"></i>
          <span>Gemini</span>
        <% end %>
      </nav>
    </div>
  </aside>

  <main class="automations-main">
    <div class="tutorial-steps">
      <% @automations.each do |automation| %>
        <%= link_to chat_path(automation.chat),
                    class: "tutorial-step-card text-decoration-none",
                    style: "display: block;",
                    aria: { current: "true" } do %>
          <div class="tutorial-step-body">
            <div class="d-flex justify-content-between align-items-baseline gap-3">
              <h3 class="tutorial-step-title mb-0"><%= automation.title %></h3>
              <small class="text-muted flex-shrink-0"><%= FR_LOCAL.format_date_standard(automation.created_at.to_date) %></small>
            </div>
            <p class="tutorial-step-text mt-2 mb-0"><%= automation.description %></p>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="d-flex justify-content-center mt-4">
      <%= button_to chats_path, class: "tutorial-outro-cta border-0" do %>
        <i class="fa-solid fa-plus"></i>
        <span>Nouvelle automation</span>
      <% end %>
    </div>
  </main>
  </div>
</div>
