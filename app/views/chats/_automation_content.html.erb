<% if automation %>
  <p><%= "Title : #{automation.title}" %></p>
  <p><%= "Description : #{automation.description}" %></p>
  <p><%= "Content : #{automation.content}" %></p>
<div class="container d-flex justify-content-center">
 <% if (tutorial = tutorial_path_for(automation)) %>
    <%= link_to "Comment installer cette automation ?", tutorial, class: "home-navbar-button" %>
  <% end %>
</div>
<% end %>
