<%= turbo_stream_from @chat %>

<%= link_to "← Home", root_path %>

<h1 id="chat_title"><%= @chat.title %></h1>

<div id="messages">
  <%= render "messages/messages", messages: @chat.messages.order(:created_at) %>
</div>

<div class="container">
  <% if @chat.automations.last %>
    <p><%= "Title : #{Automation.last.title}" %></p>
    <p><%= "Description : #{Automation.last.description}" %></p>
    <p><%= "Content : #{Automation.last.content}" %></p>
  <% end %>
</div>

<div id="new_message_container">
  <%= render "messages/form", chat: @chat, message: @message %>
</div>
