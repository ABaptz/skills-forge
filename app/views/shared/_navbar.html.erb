<header class="home-navbar">
  <div class="container home-navbar-container">
    <%= link_to root_path, class: "home-navbar-brand" do %>
      <span class="home-navbar-logo">
        <i class="fa-solid fa-hammer"></i>
      </span>

      <span>SkillForge</span>
    <% end %>

    <nav class="home-navbar-navigation">
      <% if user_signed_in? %>
        <%= link_to automations_path, class: "home-navbar-link" do %>
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <span>Mes Automations</span>
        <% end %>

        <%= button_to chats_path,
                      method: :post,
                      class: "home-navbar-button" do %>
          <i class="fa-solid fa-plus"></i>
          <span>Nouvelle Automation</span>
        <% end %>

        <details class="home-user-menu">
          <summary class="home-user-menu-trigger">
            <span class="home-navbar-avatar">
              <%= current_user.username.presence&.first&.upcase ||
                  current_user.email.first.upcase %>
            </span>

            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <div class="home-user-dropdown">
            <%= link_to profile_path(), class: "text-decoration-none" do %>
              <div class="home-user-dropdown-information">
                <strong>
                  <%= current_user.username.presence || "Utilisateur" %>
                </strong>

                <span><%= current_user.email %></span>
              </div>
            <% end %>

            <details>
              <summary class="home-user-dropdown-link" style="cursor: pointer;">
                <i class="fa-solid fa-graduation-cap"></i>
                Tutoriels
                <i class="fa-solid fa-chevron-down ms-auto"></i>
              </summary>

              <%= link_to tutorials_claude_path, class: "home-user-dropdown-link ps-4" do %>
              <i class="fa-solid fa-comment-dots"></i>
                Claude
              <% end %>

              <%= link_to tutorials_chatgpt_path, class: "home-user-dropdown-link ps-4" do %>
              <i class="fa-solid fa-robot"></i>
                ChatGPT
              <% end %>

              <%= link_to tutorials_gemini_path, class: "home-user-dropdown-link ps-4" do %>
              <i class="fa-solid fa-gem"></i>
                Gemini
              <% end %>
            </details>

            <%= button_to destroy_user_session_path,
                          method: :delete,
                          class: "home-user-dropdown-link home-logout-button",
                          form: { data: { turbo: false } } do %>
              <i class="fa-solid fa-right-from-bracket"></i>
              Déconnexion
            <% end %>
          </div>
        </details>
      <% else %>
        <%= link_to "Se connecter",
                    new_user_session_path,
                    class: "home-navbar-link" %>

        <%= link_to "Créer un compte",
                    new_user_registration_path,
                    class: "home-navbar-button" %>
      <% end %>
    </nav>
  </div>
</header>
